{
  "height": 24,
  "spacing": 0,
  "position": "bottom",
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 6,
  "margin-top": 0,
  "layer": "top",
  "exclusive": false,
  "on-sigusr1": "hide",
  "on-sigusr2": "show",
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap"
  ],
  "modules-center": [
    "custom/prayer"
  ],
  "modules-right": [
    "custom/notification",
    "pulseaudio",
    "cpu",
    "memory",
    "temperature",
    "tray",
    "privacy",
    "custom/network",
    "custom/power",
    "clock"
  ],
  "hyprland/workspaces": {
    "all-outputs": true,
    "warp-on-scroll": true,
    "on-scroll-up": "hyprctl dispatch workspace +1",
    "on-scroll-down": "hyprctl dispatch workspace -1",
    "format": "{icon}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
      "9": []
    },
    "format-icons": {
      "1": "•",
      "2": "•",
      "3": "•",
      "4": "•",
      "5": "•",
      "6": "•",
      "7": "•",
      "8": "•",
      "9": "•",
      "urgent": "",
      "default": ""
    }
  },
  // "hyprland/submap": {
  //   "format": "<span> {}</span>"
  // },
  "custom/prayer": {
    "exec": "$HOME/.config/waybar/scripts/prayer.sh",
    "return-type": "json",
    "interval": 60,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/waybar/scripts/prayer.sh menu"
  },
  "clock": {
    "format": "[ {:%H:%M} ]",
    "format-alt": "{:%A, %b %d}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "custom/notification": {
    "exec": "$HOME/.config/hypr/scripts/notification.fish status",
    "return-type": "json",
    "interval": 5,
    "signal": 4,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/hypr/scripts/notification.fish dnd"
  },
  "custom/network": {
    "exec": "$HOME/.config/waybar/scripts/network.sh",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "format": "{}",
    "on-click": "$HOME/.config/waybar/scripts/wifi-select.sh"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%   {format_source}",
    "format-bluetooth": " {volume}%   {format_source}",
    "format-bluetooth-muted": " mute   {format_source}",
    "format-muted": " mute   {format_source}",
    "format-source": "{volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "tooltip": true
  },
  "memory": {
    "format": " {used:0.1f}G",
    "interval": 5
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°",
    "format-critical": "{icon} {temperatureC}°",
    "format-icons": [
      "",
      ""
    ]
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  },
  "privacy": {
    "icon-spacing": 4,
    "icon-size": 14,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 18
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 18
      }
    ]
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/custom_modules/power_menu.xml",
    "menu-actions": {
      "logout": "hyprctl dispatch exit",
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  }
}
